# Configuración de Stripe
STRIPE_SECRET_KEY="chicos poner las env q les mande al wasa"
STRIPE_PUBLISHABLE_KEY="chicos poner las env q les mande al wasa"

# Base de datos PostgreSQL
POSTGRES_DB=transporte
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=your-secret-key-here
# '*' permite cualquier host (recomendado para Docker y EC2)
DJANGO_ALLOWED_HOSTS=*
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@transporte.local
DJANGO_SUPERUSER_PASSWORD=admin

# Detección automática de IP (para AWS EC2 y entornos cloud)
AUTO_DETECT_IP=true

# CORS automático para todos los orígenes (recomendado para Docker y EC2)
CORS_ALLOW_ALL_ORIGINS=True

# Frontend URLs (para CORS y redirecciones)
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_ALT=http://127.0.0.1:5173

# Google OAuth
GOOGLE_OAUTH2_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-client-secret

# Site ID para allauth
SITE_ID=1
ACCOUNT_EMAIL_VERIFICATION=none

# Email (MailHog para desarrollo)
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@transporte.local
EMAIL_USE_TLS=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Firebase Admin SDK Configuration
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Firebase Configuration (Get from Firebase Console)
LOG_LEVEL=INFO
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-credentials.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id

# Notification Assets (Optional)
NOTIFICATION_ICON_URL=https://your-domain.com/icon-192x192.png
NOTIFICATION_BADGE_URL=https://your-domain.com/badge-72x72.png

# Configuración de OSRM (Rutas Optimizadas)
# Usando servicio OSRM público externo
# En local/EC2: La detección automática de IP ajustará este valor si AUTO_DETECT_IP=true
OSRM_URL=https://router.project-osrm.org

# Configuración de Celery y Redis
# En Docker: usar redis (nombre del servicio)
# En local/sin Docker: cambiar a localhost o IP específica
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0