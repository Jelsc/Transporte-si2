<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permitir HTTP para desarrollo local y redes privadas -->
    <!-- En producción, cambiar cleartextTrafficPermitted a false -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

